---
interface Props {
  title?: string;
  type?: 'warsztat' | 'bezpieczenstwo' | 'ciekawostka';
}

const {
  title = 'Wskazówka z warsztatu ZST Lipno',
  type = 'warsztat',
} = Astro.props;

const icons = {
  warsztat: '🛠️',
  bezpieczenstwo: '⚠️',
  ciekawostka: '💡',
};
---

<aside class={`workshop-tip ${type}`}>
  <div class="tip-title">
    <span>{icons[type]}</span>
    <strong>{title}</strong>
  </div>
  <div class="tip-body">
    <slot />
  </div>
</aside>

<style>
  .workshop-tip {
    border-radius: 12px;
    padding: 1.15rem 1.35rem;
    margin: 1.5rem 0;
    border: 1px solid rgba(255, 107, 43, 0.35);
    background: rgba(255, 107, 43, 0.08);
  }
  .workshop-tip.bezpieczenstwo {
    border-color: rgba(245, 158, 11, 0.45);
    background: rgba(245, 158, 11, 0.09);
  }
  .workshop-tip.ciekawostka {
    border-color: rgba(0, 229, 255, 0.35);
    background: rgba(0, 229, 255, 0.07);
  }
  .tip-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.98rem;
    color: #fff;
    margin-bottom: 0.4rem;
  }
  .tip-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
