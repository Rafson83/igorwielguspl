---
interface Question {
  question: string;
  options: string[];
  correctIndex: number;
  explanation: string;
}

interface Props {
  title?: string;
  questions: Question[];
}

const {
  title = 'Sprawdź wiedzę z artykułu!',
  questions = [],
} = Astro.props;
---

<div class="quiz-box" data-quiz-box>
  <div class="quiz-header">
    <span class="quiz-pill">⚡ Szybki Test Wiedzy</span>
    <h4>{title}</h4>
  </div>

  <div class="quiz-questions">
    {questions.map((q, qIdx) => (
      <div class="quiz-item" data-question-item data-correct={q.correctIndex}>
        <p class="quiz-q"><strong>{qIdx + 1}.</strong> {q.question}</p>
        <div class="quiz-options">
          {q.options.map((opt, oIdx) => (
            <button type="button" class="quiz-opt-btn" data-opt-index={oIdx}>
              <span class="opt-letter">{String.fromCharCode(65 + oIdx)}</span>
              <span>{opt}</span>
            </button>
          ))}
        </div>
        <div class="quiz-feedback" data-feedback hidden>
          <p data-feedback-status></p>
          <p class="quiz-exp">{q.explanation}</p>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll('[data-quiz-box]').forEach((box) => {
    box.querySelectorAll('[data-question-item]').forEach((item) => {
      const correctIdx = Number(item.getAttribute('data-correct'));
      const buttons = item.querySelectorAll('[data-opt-index]');
      const feedback = item.querySelector('[data-feedback]') as HTMLElement;
      const feedbackStatus = item.querySelector('[data-feedback-status]');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const chosen = Number(btn.getAttribute('data-opt-index'));
          buttons.forEach((b) => {
            b.classList.remove('correct', 'wrong');
            (b as HTMLButtonElement).disabled = true;
          });

          if (chosen === correctIdx) {
            btn.classList.add('correct');
            if (feedbackStatus) feedbackStatus.textContent = '✅ Dobra odpowiedź!';
            feedback?.classList.add('is-correct');
          } else {
            btn.classList.add('wrong');
            buttons[correctIdx]?.classList.add('correct');
            if (feedbackStatus) feedbackStatus.textContent = '❌ Nie tym razem — zobacz wyjaśnienie:';
            feedback?.classList.add('is-wrong');
          }

          if (feedback) feedback.hidden = false;
        });
      });
    });
  });
</script>

<style>
  .quiz-box {
    background: linear-gradient(155deg, #151c29, #101520);
    border: 1px solid rgba(0, 229, 255, 0.3);
    border-radius: 16px;
    padding: 1.6rem;
    margin: 2rem 0;
  }
  .quiz-pill {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-gaming);
    background: rgba(0, 229, 255, 0.12);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    margin-bottom: 0.45rem;
  }
  .quiz-header h4 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: #fff;
    margin-bottom: 1rem;
  }
  .quiz-item {
    padding: 1rem 0;
    border-top: 1px solid var(--border-subtle);
  }
  .quiz-q {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: #f8fafc;
  }
  .quiz-options {
    display: grid;
    gap: 0.55rem;
  }
  .quiz-opt-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    text-align: left;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 0.7rem 0.95rem;
    border-radius: 10px;
    font-size: 0.92rem;
    cursor: pointer;
    transition: all 0.18s ease;
  }
  .quiz-opt-btn:hover:not(:disabled) {
    border-color: var(--accent-gaming);
    background: rgba(0, 229, 255, 0.08);
  }
  .opt-letter {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .quiz-opt-btn.correct {
    border-color: #22c55e;
    background: rgba(34, 197, 94, 0.16);
    color: #fff;
  }
  .quiz-opt-btn.wrong {
    border-color: #ef4444;
    background: rgba(239, 68, 68, 0.16);
  }
  .quiz-feedback {
    margin-top: 0.8rem;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.9rem;
  }
  .quiz-feedback.is-correct {
    border-left: 3px solid #22c55e;
  }
  .quiz-feedback.is-wrong {
    border-left: 3px solid #ef4444;
  }
  .quiz-exp {
    margin-top: 0.3rem;
    color: var(--text-secondary);
    margin-bottom: 0 !important;
  }
</style>
