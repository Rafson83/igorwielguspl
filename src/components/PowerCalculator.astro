---
interface Props {
  defaultTorque?: number;
  defaultRpm?: number;
  defaultWeight?: number;
}

const {
  defaultTorque = 320,
  defaultRpm = 4200,
  defaultWeight = 1380,
} = Astro.props;
---

<div class="calc-widget" data-calc-widget>
  <div class="calc-header">
    <span class="calc-badge">🔧 Narzędzie Warsztatowe</span>
    <h4>Kalkulator Mocy, Momentu (Nm) i Stosunku Mocy do Masy</h4>
    <p>Sprawdź jak moment obrotowy i obroty silnika (RPM) przekładają się na konie mechaniczne (KM) oraz kilowaty (kW).</p>
  </div>

  <div class="calc-grid">
    <div class="calc-input-group">
      <label>
        <span>Moment obrotowy: <strong data-val-torque>{defaultTorque}</strong> Nm</span>
        <input type="range" min="80" max="900" step="5" value={defaultTorque} data-in-torque />
      </label>
    </div>

    <div class="calc-input-group">
      <label>
        <span>Obroty (RPM): <strong data-val-rpm>{defaultRpm}</strong> obr./min</span>
        <input type="range" min="1500" max="8500" step="100" value={defaultRpm} data-in-rpm />
      </label>
    </div>

    <div class="calc-input-group">
      <label>
        <span>Masa auta: <strong data-val-weight>{defaultWeight}</strong> kg</span>
        <input type="range" min="800" max="2600" step="20" value={defaultWeight} data-in-weight />
      </label>
    </div>
  </div>

  <div class="calc-results">
    <div class="calc-res-box primary">
      <span class="res-label">Moc maksymalna (KM)</span>
      <span class="res-num" data-out-hp>0 KM</span>
    </div>
    <div class="calc-res-box">
      <span class="res-label">Moc w kilowatach (kW)</span>
      <span class="res-num" data-out-kw>0 kW</span>
    </div>
    <div class="calc-res-box">
      <span class="res-label">Stosunek mocy do masy</span>
      <span class="res-num" data-out-ptw>0 KM/t</span>
    </div>
  </div>

  <div class="calc-formula">
    Wzór warsztatowy: <code>Moc (KM) = (Moment [Nm] × RPM) / 7023.5</code> | <code>1 kW = 1.36 KM</code>
  </div>
</div>

<script>
  document.querySelectorAll('[data-calc-widget]').forEach((widget) => {
    const inTorque = widget.querySelector('[data-in-torque]') as HTMLInputElement;
    const inRpm = widget.querySelector('[data-in-rpm]') as HTMLInputElement;
    const inWeight = widget.querySelector('[data-in-weight]') as HTMLInputElement;

    const valTorque = widget.querySelector('[data-val-torque]');
    const valRpm = widget.querySelector('[data-val-rpm]');
    const valWeight = widget.querySelector('[data-val-weight]');

    const outHp = widget.querySelector('[data-out-hp]');
    const outKw = widget.querySelector('[data-out-kw]');
    const outPtw = widget.querySelector('[data-out-ptw]');

    function update() {
      const torque = Number(inTorque.value);
      const rpm = Number(inRpm.value);
      const weight = Number(inWeight.value);

      if (valTorque) valTorque.textContent = String(torque);
      if (valRpm) valRpm.textContent = String(rpm);
      if (valWeight) valWeight.textContent = String(weight);

      const hp = (torque * rpm) / 7023.5;
      const kw = hp / 1.35962;
      const ptw = (hp / weight) * 1000;

      if (outHp) outHp.textContent = `${Math.round(hp)} KM`;
      if (outKw) outKw.textContent = `${Math.round(kw)} kW`;
      if (outPtw) outPtw.textContent = `${Math.round(ptw)} KM/t`;
    }

    inTorque?.addEventListener('input', update);
    inRpm?.addEventListener('input', update);
    inWeight?.addEventListener('input', update);
    update();
  });
</script>

<style>
  .calc-widget {
    background: linear-gradient(155deg, #161d2b, #0f141e);
    border: 1px solid rgba(255, 107, 43, 0.35);
    border-radius: 16px;
    padding: 1.6rem;
    margin: 2rem 0;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.3);
  }
  .calc-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #ff8e5e;
    background: rgba(255, 107, 43, 0.14);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    margin-bottom: 0.5rem;
  }
  .calc-header h4 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: #fff;
    margin-bottom: 0.3rem;
  }
  .calc-header p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }
  .calc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .calc-input-group {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    padding: 0.9rem 1rem;
    border-radius: 10px;
  }
  .calc-input-group label {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
  .calc-input-group strong {
    color: #fff;
    font-family: var(--font-mono);
  }
  .calc-input-group input[type="range"] {
    width: 100%;
    accent-color: var(--accent-garage);
    cursor: pointer;
  }
  .calc-results {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.85rem;
    margin-bottom: 1rem;
  }
  .calc-res-box {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 0.9rem 1rem;
    text-align: center;
  }
  .calc-res-box.primary {
    border-color: rgba(255, 107, 43, 0.5);
    background: rgba(255, 107, 43, 0.1);
  }
  .res-label {
    display: block;
    font-size: 0.76rem;
    color: var(--text-secondary);
    margin-bottom: 0.25rem;
  }
  .res-num {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 800;
    color: #fff;
  }
  .calc-res-box.primary .res-num {
    color: var(--accent-garage);
  }
  .calc-formula {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-align: center;
  }
</style>
